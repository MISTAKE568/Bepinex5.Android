# build products
out/
apks/
*.apk
*.apk.idsig

# Keep local APK signing keys out of source control.
*.keystore
*.jks
*.p12
*.pfx

# binaries produced by builds (sources live in shim/)
*.so
*.a
*.o

# compiled runtime/tool products must never be committed:
# CI builds them into the asset pack (see assets.py); enforced by
# ci/check_source_tree.py in CI.
*.dll
*.exe
*.jar
*.dex
*.pyd
*.lib

# .NET
bin/
obj/
*.user
*.suo
.vs/

# python
__pycache__/
*.pyc
.venv/

# patch/build debris — must never reach a release
*.bak
*.orig
*.rej
*.tmp

# local-only test artifacts
payload/patchers/
injector/apk/refs/

# shim build tree (CMakeCache, ninja files, objects)
shim/build*/

# upstream snapshot is fetched, not vendored verbatim
upstream/*/

# CI workspace staging (GitHub Actions)
build/
dist/

# generated by CI to supply net35 reference assemblies on Linux
src/BepInEx/Directory.Build.targets

# local-only working documents (analyst workspace; never shipped, never committed)
/local-docs/
